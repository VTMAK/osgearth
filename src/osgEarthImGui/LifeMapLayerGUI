#pragma once
#include <osgEarthImGui/ImGuiPanel>
#include <osgEarthProcedural/LifeMapLayer>
#include <osgEarthProcedural/TextureSplattingLayer>
#include <osgEarth/ExampleResources>
#include <osgEarth/VirtualProgram>
#include <mutex>

namespace {
    const char* render_lifemap = R"(
#version 450
#pragma vp_function oeiu_render_lifemap, fragment_lighting, last
void oeiu_render_lifemap(inout vec4 color) { color.a = 1.0; }
)";
    const char* render_density = R"(
#version 450
#pragma vp_function oeui_render_density, fragment_lighting, last
void oeui_render_density(inout vec4 color) { color = vec4(0,color.g,0,1); }
)";

    const char* render_lush = R"(
#version 450
#pragma vp_function oeui_render_lush, fragment_lighting, last
void oeui_render_lush(inout vec4 color) { color = vec4(0,0,color.b, 1); }
)";

    const char* render_rugged = R"(
#version 450
#pragma vp_function oeui_render_rugged, fragment_lighting, last
void oeui_render_rugged(inout vec4 color) { color = vec4(color.r, 0, 0, 1); }
)";

    const char* render_alpha = R"(
#version 450
#pragma vp_function oeui_render_alpha, fragment_lighting, last
void oeui_render_alpha(inout vec4 color) { color = vec4(color.a, color.a, color.a, 1.0); }
)";
}

namespace osgEarth
{
    namespace Procedural
    {
        using namespace osgEarth;

        struct LifeMapLayerGUI : public ImGuiPanel
        {
            struct MouseState
            {
                std::mutex mutex;
                osg::observer_ptr<osg::View> view;
                float x = 0.0f, y = 0.0f;
                bool pending = false;
            };

            std::shared_ptr<MouseState> _mouseState;
            osg::observer_ptr<osgViewer::View> _eventView;
            osg::observer_ptr<MapNode> _mapNode;
            osg::observer_ptr<LifeMapLayer> _lifemap;
            osg::observer_ptr<TextureSplattingLayer> _splat;
            std::string _renderMode;
            int _renderModeIndex = 0;
            bool _showLifemapUnderMouse;
            Future<osg::Vec4> _lifemapUnderMouse;
            bool _showLandcoverUnderMouse;
            Future<LandCoverSample> _landcoverUnderMouse;
            TileKey _keyUnderMouse;

            LifeMapLayerGUI() : ImGuiPanel("Life Map"),
                _showLifemapUnderMouse(false),
                _showLandcoverUnderMouse(false)
            {
                //nop
            }

            ~LifeMapLayerGUI() override
            {
                _mouseState.reset();
                _lifemapUnderMouse.reset();
                _landcoverUnderMouse.reset();
            }

            void setRenderMode(const std::string& mode, LifeMapLayer* lifemap, TextureSplattingLayer* splat)
            {
                auto* vp = VirtualProgram::getOrCreate(lifemap->getOrCreateStateSet());

                if (!_renderMode.empty())
                    ShaderLoader::unload(vp, _renderMode);
                _renderMode = mode;
                if (!_renderMode.empty())
                    ShaderLoader::load(vp, _renderMode);

                bool show = !_renderMode.empty();
                lifemap->setVisible(show);
                if (splat)
                    splat->setVisible(!show);
            }

            void draw(osg::RenderInfo& ri) override
            {
                osg::ref_ptr<MapNode> mapNode = ri.getCurrentCamera() ? findNode<MapNode>(ri) : nullptr;
                osg::ref_ptr<LifeMapLayer> lifemap;
                osg::ref_ptr<TextureSplattingLayer> splat;
                if (mapNode.valid() && mapNode->getMap())
                {
                    LayerVector layers;
                    mapNode->getMap()->getLayers(layers);
                    for (auto& layer : layers)
                    {
                        if (!lifemap.valid())
                            lifemap = dynamic_cast<LifeMapLayer*>(layer.get());
                        if (!splat.valid())
                            splat = dynamic_cast<TextureSplattingLayer*>(layer.get());
                    }
                }

                osg::ref_ptr<MapNode> oldMapNode;
                osg::ref_ptr<LifeMapLayer> oldLifemap;
                osg::ref_ptr<TextureSplattingLayer> oldSplat;
                _mapNode.lock(oldMapNode);
                _lifemap.lock(oldLifemap);
                _splat.lock(oldSplat);
                if (mapNode != oldMapNode || lifemap != oldLifemap || splat != oldSplat)
                {
                    _lifemapUnderMouse.reset();
                    _landcoverUnderMouse.reset();
                    _keyUnderMouse = {};
                    if (lifemap != oldLifemap)
                    {
                        _renderMode.clear();
                        _renderModeIndex = 0;
                    }
                    _mapNode = mapNode;
                    _lifemap = lifemap;
                    _splat = splat;
                }

                if (!mapNode.valid() || !lifemap.valid() || !lifemap->isOpen())
                {
                    _mouseState.reset();
                    _lifemapUnderMouse.reset();
                    _landcoverUnderMouse.reset();
                    _keyUnderMouse = {};
                    setVisible(false);
                    return;
                }

                osg::ref_ptr<osgViewer::View> currentView = view(ri);
                osg::ref_ptr<osgViewer::View> eventView;
                _eventView.lock(eventView);
                if (currentView != eventView)
                {
                    _mouseState.reset();
                    _lifemapUnderMouse.reset();
                    _landcoverUnderMouse.reset();
                    _keyUnderMouse = {};
                    _eventView = currentView;
                }
                if (currentView.valid() && !_mouseState)
                {
                    _mouseState = std::make_shared<MouseState>();
                    std::weak_ptr<MouseState> weakMouseState = _mouseState;
                    // The router can outlive the panel; scene access stays on the draw thread.
                    EventRouter::get(currentView).onMove([weakMouseState](osg::View* v, float x, float y)
                    {
                        auto state = weakMouseState.lock();
                        if (!state) return;
                        std::lock_guard<std::mutex> lock(state->mutex);
                        state->view = v;
                        state->x = x;
                        state->y = y;
                        state->pending = true;
                    });
                }

                if (_mouseState)
                {
                    osg::ref_ptr<osg::View> mouseView;
                    float x = 0.0f, y = 0.0f;
                    bool pending;
                    {
                        std::lock_guard<std::mutex> lock(_mouseState->mutex);
                        pending = _mouseState->pending;
                        _mouseState->pending = false;
                        _mouseState->view.lock(mouseView);
                        x = _mouseState->x;
                        y = _mouseState->y;
                    }
                    if (pending && mouseView.valid() && mouseView.get() == currentView.get())
                        onMove(mouseView.get(), x, y, mapNode.get(), lifemap.get());
                }

                ImGui::Begin("Life Map");

                // render the layer?
                ImGui::TextColored(ImVec4(1, 1, 0, 1), "Visualization");
                {
                    int m = 0;

                    if (ImGui::RadioButton("Normal", &_renderModeIndex, m++)) {
                        setRenderMode("", lifemap.get(), splat.get());
                    }
                    if (ImGui::RadioButton("Ruggedness", &_renderModeIndex, m++)) {
                        setRenderMode(render_rugged, lifemap.get(), splat.get());
                    }
                    if (ImGui::RadioButton("Density", &_renderModeIndex, m++)) {
                        setRenderMode(render_density, lifemap.get(), splat.get());
                    }
                    if (ImGui::RadioButton("Lushness", &_renderModeIndex, m++)) {
                        setRenderMode(render_lush, lifemap.get(), splat.get());
                    }
                    if (ImGui::RadioButton("Material", &_renderModeIndex, m++)) {
                        setRenderMode(render_alpha, lifemap.get(), splat.get());
                    }
                    if (ImGui::RadioButton("All", &_renderModeIndex, m++)) {
                        setRenderMode(render_lifemap, lifemap.get(), splat.get());
                    }
                }

                LifeMapLayer::Options& o = lifemap->options();

                ImGui::Separator();
                ImGui::TextColored(ImVec4(1, 1, 0, 1), "LifeMap Generator levels:");

                if (ImGuiLTable::Begin("LifeMap"))
                {
                    ImGuiLTable::SliderFloat("Coverage contrib", &o.landCoverWeight().mutable_value(), 0.0f, 1.0f);
                    if (o.landCoverWeight().value() > 0.0f)
                    {
                        float value = o.landCoverBlur()->as(Units::METERS);
                        if (ImGuiLTable::SliderFloat("Coverage blur (m)", &value, 0.0f, 100.0f, "%.2f", ImGuiSliderFlags_Logarithmic))
                            o.landCoverBlur()->set(value, Units::METERS);
                    }

                    if (lifemap->getColorLayer())
                    {
                        ImGuiLTable::SliderFloat("Imagery color contrib", &o.colorWeight().mutable_value(), 0.0f, 1.0f);
                    }

                    ImGuiLTable::SliderFloat("Terrain contrib", &o.terrainWeight().mutable_value(), 0.0f, 1.0f);
                    //ImGuiLTable::SliderFloat("Slope contrib", &o.slopeIntensity().mutable_value(), 1.0f, 10.0f);
                    //ImGuiLTable::SliderFloat("Slope cutoff", &o.slopeCutoff().mutable_value(), 0.0f, 1.0f);

                    ImGuiLTable::SliderFloat("Noise contrib", &o.noiseWeight().mutable_value(), 0.0f, 1.0f);

                    ImGuiLTable::End();
                }

                if (ImGui::Button("Apply Changes"))
                {
                    // make sure the cache is off
                    lifemap->setCachePolicy(CachePolicy::NO_CACHE);

                    auto* engine = mapNode->getTerrainEngine();
                    if (engine)
                        engine->invalidateRegion({ lifemap.get() }, GeoExtent::INVALID);
                }

                ImGui::Separator();
                ImGui::Checkbox("Show lifemap under mouse", &_showLifemapUnderMouse);
                if (_showLifemapUnderMouse && _lifemapUnderMouse.available())
                {
                    osg::Vec4 pixel = _lifemapUnderMouse.value();
                    ImGui::Text("R=%.2f D=%.2f L=%.2f M=%d",
                        pixel.r(),
                        pixel.g(),
                        pixel.b(),
                        (int)(pixel.a() * 255.0f));
                }

                if (lifemap->getLandCoverLayer())
                {
                    ImGui::Separator();
                    ImGui::Checkbox("Show landcover under mouse", &_showLandcoverUnderMouse);
                    if (_showLandcoverUnderMouse && _landcoverUnderMouse.available())
                    {
                        LandCoverSample sample = _landcoverUnderMouse.value();
                        if (sample.biomeid().isSet())
                            ImGui::Text("biome_id = %s", sample.biomeid().get().c_str());
                        if (sample.dense().isSet())
                            ImGui::Text("dense = %.2f", sample.dense().get());
                        if (sample.lush().isSet())
                            ImGui::Text("lush = %.2f", sample.lush().get());
                        if (sample.rugged().isSet())
                            ImGui::Text("rugged = %.2f", sample.rugged().get());
                        if (sample.material().isSet())
                            ImGui::Text("material = %s", sample.material().get().c_str());
                        if (sample.soiltype().isSet())
                            ImGui::Text("soiltype = %s", sample.soiltype().get().c_str());
                    }
                }

                ImGui::Text("Last tile under mouse:");
                ImGui::SameLine();
                if (_keyUnderMouse.valid())
                    ImGui::Text("%s", _keyUnderMouse.str().c_str());
                else
                    ImGui::Text("%s", "not found");

                ImGui::End();
            }

            bool getKeyUnderMouse(osg::View* view, float x, float y,
                MapNode* mapNode, TileKey& key, GeoPoint& point)
            {
                key = {};
                point = {};
                _keyUnderMouse = {};
                if (!view || !mapNode || !mapNode->getMap() || !mapNode->getMap()->getProfile())
                    return false;

                osg::ref_ptr<Terrain> terrain = mapNode->getTerrain();
                if (!terrain.valid())
                    return false;

                auto* tile = terrain->getTerrainTileUnderMouse(view, x, y);
                if (!tile)
                    return false;
                const auto lod = tile->getKey().getLOD();

                osg::Vec3d world;
                if (!terrain->getWorldCoordsUnderMouse(view, x, y, world) ||
                    !point.fromWorld(mapNode->getMapSRS(), world))
                    return false;

                key = _keyUnderMouse = mapNode->getMap()->getProfile()->createTileKey(point.x(), point.y(), lod);
                return key.valid();
            }

            void onMove(osg::View* view, float x, float y, MapNode* mapNode, LifeMapLayer* lifemap)
            {
                _lifemapUnderMouse.reset();
                _landcoverUnderMouse.reset();
                if (!_showLifemapUnderMouse && !_showLandcoverUnderMouse)
                    return;

                TileKey keyUnderMouse;
                GeoPoint pointUnderMouse;
                if (!lifemap || !lifemap->isOpen() ||
                    !getKeyUnderMouse(view, x, y, mapNode, keyUnderMouse, pointUnderMouse))
                    return;

                // Keep the map and its layers alive until the sampling jobs finish.
                osg::ref_ptr<MapNode> owner = mapNode;
                osg::ref_ptr<LifeMapLayer> layer = lifemap;

                if (_showLifemapUnderMouse)
                {
                    TileKey key = layer->getBestAvailableTileKey(keyUnderMouse, false);
                    if (key.valid())
                    {
                        auto task = [owner, layer, key, pointUnderMouse](Cancelable& c)
                            {
                                osg::Vec4 result(0, 0, 0, 1);
                                if (c.canceled() || !layer->isOpen())
                                    return result;
                                osg::ref_ptr<ProgressCallback> prog = new ProgressCallback(&c);

                                for (auto k = key; k.valid() && !c.canceled(); k.makeParent())
                                {
                                    auto g = layer->createImage(k, prog.get());
                                    if (g.valid())
                                    {
                                        g.getReader().setBilinear(false);
                                        g.read(result, pointUnderMouse);
                                        break;
                                    }
                                }
                                return result;
                            };

                        _lifemapUnderMouse = jobs::dispatch(task);
                    }
                }

                if (_showLandcoverUnderMouse)
                {
                    osg::ref_ptr<CoverageLayer> coverage = layer->getLandCoverLayer();
                    if (!coverage.valid() || !coverage->isOpen())
                        return;

                    TileKey key = coverage->getBestAvailableTileKey(keyUnderMouse, false);
                    if (key.valid())
                    {
                        auto task = [owner, coverage, key, pointUnderMouse](Cancelable& c)
                            {
                                LandCoverSample result;
                                if (c.canceled() || !coverage->isOpen())
                                    return result;
                                osg::ref_ptr<ProgressCallback> prog = new ProgressCallback(&c);
                                auto factory = LandCoverSample::Factory::create(coverage.get());
                                if (!factory)
                                    return result;
                                for (auto k = key; k.valid() && !c.canceled(); k.makeParent())
                                {
                                    auto g = factory->createCoverage(k, prog.get());
                                    if (g.valid())
                                    {
                                        g.readAtCoords(result, pointUnderMouse.x(), pointUnderMouse.y());
                                        break;
                                    }
                                }
                                return result;
                            };
                        _landcoverUnderMouse = jobs::dispatch(task);
                    }
                }
            }
        };
    }
}
